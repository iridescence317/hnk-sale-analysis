{
    "name": "pl_teams_notification",
    "properties": {
        "activities": [
            {
                "name": "Send Notification to Teams",
                "type": "WebActivity",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "POST",
                    "url": {
                        "value": "@pipeline().parameters.webhookUrl",
                        "type": "Expression"
                    },
                    "body": {
                        "value": "{\n  \"pipelineName\": \"@{pipeline().parameters.pipelineName}\",\n  \"runStatus\": \"@{pipeline().parameters.runStatus}\",\n  \"startTime\": \"@{pipeline().parameters.startTime}\",\n  \"endTime\": \"@{pipeline().parameters.endTime}\",\n  \"runUrl\": \"@{pipeline().parameters.runUrl}\"\n}",
                        "type": "Expression"
                    }
                }
            }
        ],
        "parameters": {
            "webhookUrl": {
                "type": "string"
            },
            "pipelineName": {
                "type": "string"
            },
            "runStatus": {
                "type": "string"
            },
            "startTime": {
                "type": "string"
            },
            "endTime": {
                "type": "string"
            },
            "runUrl": {
                "type": "string"
            }
        },
        "annotations": []
    }
}